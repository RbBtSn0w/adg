{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://RbBtSn0w.dev/schemas/plugin-lock.schema.json",
  "title": "ADG Plugin Lock File",
  "description": "Records installed plugins and their exact provenance/state for reproducible environments (.plugin-lock.json).",
  "type": "object",
  "required": ["version", "plugins"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "description": "Lock file format version.", "enum": [3, 4, 5, 6] },
    "plugins": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/lockEntry" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "mode", "roots", "excluded", "appliedMigrations"],
        "properties": {
          "source": {"type": "string"},
          "ref": {"type": "string"},
          "mode": {"enum": ["all", "selected"]},
          "roots": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "excluded": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "targets": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "sparse": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "appliedMigrations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "selection": {"$ref": "#/$defs/lockEntry/properties/selection"},
          "withDeps": {"type": "boolean"},
          "desiredSelections": {
            "type": "object",
            "additionalProperties": {"anyOf": [{"$ref": "#/$defs/lockEntry/properties/selection"}, {"type": "null"}]}
          },
          "retainedAtRevision": {"type": "string"},
          "retained": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "executableDecisions": {"type": "object", "additionalProperties": {"type": "boolean"}},
          "deferredRecovery": {
            "type": "array",
            "description": "Unknown historical choices deferred locally without granting installation or removal permission.",
            "items": {
              "type": "object",
              "required": ["id", "history", "skills"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string"},
                "history": {"$ref": "#/properties/sources/items/properties/history/items"},
                "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              }
            }
          },
          "history": {
            "type": "array",
            "description": "Installation evidence maintained locally by ADG for update recovery.",
            "items": {
              "type": "object",
              "required": ["name", "version", "origin", "contents"],
              "additionalProperties": false,
              "properties": {
                "name": {"type": "string"},
                "version": {"type": "string"},
                "sourceHash": {"type": "string"},
                "origin": {"$ref": "#/$defs/lockEntry/properties/origin"},
                "contents": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "skills": {"type": "array", "items": {"type": "string"}},
                    "agents": {"type": "array", "items": {"type": "string"}},
                    "commands": {"type": "array", "items": {"type": "string"}},
                    "hooks": {"type": "array", "items": {"type": "string"}},
                    "apps": {"type": "array", "items": {"type": "string"}},
                    "mcp": {"type": "array", "items": {"type": "string"}}
                  },
                  "required": ["skills", "agents", "commands", "hooks", "apps", "mcp"]
                },
                "selection": {"$ref": "#/$defs/lockEntry/properties/selection"},
                "selectionKnown": {"type": "boolean"},
                "effectiveSelection": {"$ref": "#/$defs/lockEntry/properties/selection"},
                "evidence": {"enum": ["selection", "installed", "catalog"]},
                "state": {"enum": ["enabled", "disabled"]}
              }
            }
          }
        }
      }
    },
    "lastSelected": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "lockEntry": {
      "type": "object",
      "required": ["origin", "version", "sourceHash", "installedHash", "installedAt", "updatedAt"],
      "additionalProperties": false,
      "properties": {
        "origin": { "$ref": "#/$defs/source" },
        "version": { "type": "string" },
        "sourceHash": {
          "type": "string",
          "description": "Digest of the complete cached source payload.",
          "pattern": "^[a-z0-9]+-[0-9a-f]+$"
        },
        "resolvedRevision": {
          "type": "string",
          "description": "Immutable remote commit that produced the cached source payload."
        },
        "installedHash": {
          "type": "string",
          "description": "Digest of the effective runtime installation.",
          "pattern": "^[a-z0-9]+-[0-9a-f]+$"
        },
        "installedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "state": {
          "enum": ["enabled", "disabled"],
          "description": "Desired cross-agent projection state. Absent means enabled."
        },
        "selectionKnown": {"type": "boolean", "description": "Whether requested selection intent is known, including an explicit full installation."},
        "runtimeStates": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "definition": {
          "type": "object",
          "required": ["kind", "root", "description", "fingerprint"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "default-dsl/v1" },
            "root": { "const": "." },
            "as": { "type": "string" },
            "description": { "type": "string" },
            "fingerprint": { "type": "string" },
            "authorizedComponents": {
              "type": "array",
              "items": { "enum": ["skills", "agents", "commands", "mcp", "hooks", "apps"] },
              "uniqueItems": true,
              "description": "Structural components explicitly authorized at install time."
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "selection": {
          "type": "object",
          "description": "Partial-install selection: which components/skills are physically materialized and exposed. Absent = install everything.",
          "required": ["components"],
          "additionalProperties": false,
          "properties": {
            "components": {
              "type": "array",
              "items": { "enum": ["skills", "agents", "commands", "mcp", "hooks", "apps"] }
            },
            "mcp": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "skills": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "path"],
          "additionalProperties": false,
          "properties": { "type": { "const": "local" }, "path": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["type", "repo"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "github" },
            "repo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
            "ref": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "url"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "git" },
            "url": { "type": "string" },
            "ref": { "type": "string" },
            "path": { "type": "string" }
          }
        }
      ]
    }
  }
}
